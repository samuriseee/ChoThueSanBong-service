# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DB_SYNCHRONIZE=true
DB_LOGGING=false

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=soccer-rental

# Upload
MAX_UPLOAD_MB=10

# Email (Gmail - dùng cho nodemailer service 'gmail')
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password-or-app-specific-password

# VNPAY (thanh toán)
vnp_TmnCode=             # Mã cửa hàng (terminal code)
vnp_HashSecret=          # Hash secret để tạo chữ ký
vnp_Url=https://pay.vnpay.vn/vpcpay.html
vnp_ReturnUrl=https://your-backend.com/api/payment/vnpay-return
FE_PAYMENT_RETURN_URL=http://localhost:3000/vi/return-vnpay
